# =============================================================================
# IoT Jet Engine Lakehouse — environment configuration
#
# Every value below is ALSO the inline default in docker-compose.yml, so this
# file is optional. To customise: `cp infrastructure/.env.example infrastructure/.env`
# and edit. Docker Compose reads `.env` from the directory of the compose file.
# Never commit the real `.env` (it is git-ignored).
# =============================================================================

# ------------------------------------------------------------------ Network
# Interface every published port binds to. The default keeps the stack (and its
# default credentials) reachable from this machine only; use 0.0.0.0 to expose
# it on your network, and only after changing every password below.
BIND_HOST=127.0.0.1

# ----------------------------------------------------------------- PostgreSQL
POSTGRES_DB=jet_engine_db            # operational edge database
POSTGRES_USER=admin                  # superuser (also used by Debezium for replication)
POSTGRES_PASSWORD=adminpassword
POSTGRES_PORT=5432                   # host port -> container 5432
PG_MAX_SLOT_WAL_KEEP_SIZE=4GB        # WAL a stalled CDC slot may pin before it is invalidated

# ------------------------------------------------------------- Kafka (KRaft)
KAFKA_PORT=9092                      # host listener (PLAINTEXT_HOST://localhost:9092)
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk   # base64 UUID; change only on a fresh volume
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
CDC_TOPIC_PREFIX=engine_cdc          # topics: <prefix>.public.<table>
CDC_TOPIC_PARTITIONS=3
CDC_TOPIC_RETENTION_MS=604800000     # 7 days

# ------------------------------------------------- Debezium (Kafka Connect)
DEBEZIUM_PORT=8083                   # host port for the Connect REST API
DEBEZIUM_GROUP_ID=engine-cdc-connect
DEBEZIUM_CONFIG_TOPIC=_connect_configs
DEBEZIUM_OFFSET_TOPIC=_connect_offsets
DEBEZIUM_STATUS_TOPIC=_connect_statuses
DEBEZIUM_HEAP_OPTS=-Xms256m -Xmx1g

# ------------------------------------------------------------ MinIO (S3 API)
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372   # community MinIO build, digest-pinned
MC_IMAGE=pgsty/mc:RELEASE.2026-10-25T00-00-00Z@sha256:770d5f14a70ecb88e0086d3a8061de726309bee986298fef06f09429fdd683cf         # community mc client build, digest-pinned
MINIO_ROOT_USER=minioadmin           # also the S3 access key used by Spark/ML
MINIO_ROOT_PASSWORD=minioadmin       # min. 8 characters
MINIO_API_PORT=9000                  # host port for the S3 API
MINIO_CONSOLE_PORT=9001              # host port for the web console
LAKEHOUSE_BUCKET=lakehouse           # zones: bronze/ silver/ gold/ ml-artifacts/
AWS_REGION=us-east-1

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=iot_engine             # raw_*, dbt silver/gold models, predictions
CLICKHOUSE_HTTP_PORT=8123            # host port -> HTTP interface
CLICKHOUSE_TCP_PORT=19000            # host port -> native protocol (9000 is MinIO's)

# --------------------------------------------------- Engine fleet simulator
SIM_ENGINE_IDS=JT9D-001,JT9D-002,CFM56-104,CFM56-105,GE90-201,GE90-202
SIM_TICK_SECONDS=1.0                 # one telemetry pulse per engine per tick
SIM_PULSES_PER_CYCLE=10              # pulses per operating cycle; a change applies from each engine's next lifecycle
SIM_MEAN_LIFE_CYCLES=180             # mean cycles from overhaul to failure; a change applies from each engine's next lifecycle
SIM_BACKFILL_LIFECYCLES=4            # history generated for every engine that has no telemetry yet
SIM_MAINTENANCE_SECONDS=20           # simulated repair downtime after a failure
SIM_SEED=42                          # reproducible fleet behaviour; a change applies from each engine's next lifecycle
LOG_LEVEL=INFO

# ------------------------------------------------------------------ Grafana
GRAFANA_PORT=3000                    # host port of the dashboards (http://localhost:3000)
GRAFANA_ADMIN_USER=admin             # created on the first start of the grafana-data volume
GRAFANA_ADMIN_PASSWORD=admin         # dev-only default; applied only when the grafana-data volume is created
GRAFANA_ANONYMOUS_ENABLED=false      # true = Viewer access without login; keep false when BIND_HOST exposes the stack
GRAFANA_MEM_LIMIT=1g                 # memory limit of the Grafana container (idles at ~290 MB)
GRAFANA_CLICKHOUSE_PASSWORD=grafana-readonly   # SELECT-only ClickHouse account Grafana queries with

# ----------------------------- High-frequency (HF) sensor frames: the "big data" path
# Each tick every engine also emits one Avro frame of kHz vibration waveforms plus
# ~80 redundant process channels to Kafka (Schema Registry, zstd). Defaults are sized
# for a laptop (~115 KB/s for 6 engines); raise the rates or use `make load-test` to
# measure how far one producer scales. Raw frames expire from the lake after
# HF_BRONZE_RETENTION_DAYS; their features are kept.
SCHEMA_REGISTRY_PORT=8081            # host port for the Schema Registry REST API
SCHEMA_COMPATIBILITY_LEVEL=backward  # schema evolution rule enforced by the registry
SCHEMA_REGISTRY_HEAP_OPTS=-Xms128m -Xmx384m
HF_TOPIC=engine_hf.sensor_frames
HF_BENCHMARK_TOPIC=engine_hf.benchmark
HF_TOPIC_PARTITIONS=6
HF_TOPIC_RETENTION_MS=7200000        # 2 hours of raw frames in Kafka
HF_BRONZE_RETENTION_DAYS=1           # MinIO lifecycle expiry of bronze/engine_sensor_frames/
SIM_HF_ENABLED=true
SIM_HF_SAMPLE_RATE_HZ=2048           # vibration sample rate per channel (real systems: 10-50 kHz)
SIM_HF_VIB_CHANNELS=2                # accelerometers per engine (fan frame, turbine rear frame, ...)
SIM_HF_PROCESS_RATE_HZ=8             # sample rate of the process channels
SIM_HF_FRAME_MS=1000                 # frame period
SIM_HF_COMPRESSION=zstd              # Kafka producer compression
SIM_HF_QUEUE_MAX_MB=256              # producer buffer; frames beyond it are dropped and counted
HF_LAKE_TRIGGER_SECONDS=60           # micro-batch interval of the HF lake queries
HF_CLICKHOUSE_TRIGGER_SECONDS=10     # micro-batch interval of the HF feature query
HF_MAX_OFFSETS_PER_TRIGGER=2000      # frames per HF micro-batch (bounds memory per batch)

# ------------------------------------------------- Spark structured streaming
SPARK_UI_PORT=4040
SPARK_DRIVER_MEMORY=2g
SPARK_LOG_LEVEL=WARN
LAKE_TRIGGER_SECONDS=60              # Path A micro-batch interval (MinIO parquet)
CLICKHOUSE_TRIGGER_SECONDS=5         # Path B micro-batch interval (ClickHouse)
KAFKA_STARTING_OFFSETS=earliest
MAX_OFFSETS_PER_TRIGGER=20000
# true: a CDC query whose unread records were already deleted by topic retention (an
# outage longer than CDC_TOPIC_RETENTION_MS) fails loudly with recovery steps in the
# log. Set false only knowingly, to skip such a gap once, then set it back to true.
KAFKA_FAIL_ON_DATA_LOSS=true

# --------------------------------------- Orchestration, dbt & data science
DBT_INTERVAL_SECONDS=120             # dbt run + dbt test cadence
PREDICT_INTERVAL_SECONDS=60          # RUL inference cadence
SNAPSHOT_INTERVAL_SECONDS=900        # ClickHouse -> MinIO parquet feature snapshots
TRAIN_INTERVAL_SECONDS=1800          # retraining cadence (only when new lifecycles completed)
SNAPSHOT_RETENTION=5                 # snapshots kept per dataset
RUL_FAILURE_HORIZON_CYCLES=25        # "imminent failure" = RUL <= horizon
RUL_CAP_CYCLES=125                   # piecewise-linear RUL target cap
MIN_TRAINING_LIFECYCLES=6            # completed lifecycles required before training (at least 3: train/validation/test)
FLIGHT_HOURS_PER_CYCLE=2.0           # converts predicted cycles to hours
MODEL_PROMOTION_POLICY=better        # better = floors + lower RMSE + F1 within tolerance | always = floors only
ML_ARTIFACT_PREFIX=ml-artifacts/rul_model
TRAINING_MAX_ROWS=600000             # max mart rows one training run loads (newest completed lifecycles first)
SNAPSHOT_WINDOW_DAYS=7               # days of event time exported in the silver feature snapshot
PROMOTION_MIN_R2=0.5                 # promotion floor: challenger holdout R2 (every policy, also 'always')
PROMOTION_MIN_ROC_AUC=0.75           # promotion floor: challenger holdout classifier ROC-AUC (every policy)
PROMOTION_F1_TOLERANCE=0.05          # policy better: classifier F1 the challenger may lose vs the champion
ORCHESTRATOR_MEM_LIMIT=3g            # memory limit of the dbt/ML job container
PIPELINE_GATE_ON_DBT_TESTS=true      # a failed dbt test skips training and the lake snapshot of that cycle
